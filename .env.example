# Google AI (Gemini) — 谱面识别 + AI 追问教练
# 在 https://aistudio.google.com/apikey 创建密钥，粘贴到项目根目录 .env（勿提交 git）
GOOGLE_API_KEY=你的Google_API密钥

# 开发默认关闭 TTS，省配额；上线或需要试听时改为 true
GOOGLE_TTS_ENABLED=false

# 推荐 gemini-3.5-flash-lite（识谱稳定、配额更省）
GOOGLE_MODEL=gemini-3.5-flash-lite

# 文字点评转语音（Gemini TTS，与上面同一密钥，无需 ElevenLabs）
# GOOGLE_TTS_MODEL=gemini-2.5-flash-preview-tts
# GOOGLE_TTS_VOICE=Kore
# GOOGLE_TTS_STYLE=温柔、鼓励型的中文长笛老师，语速适中，发音清晰

# 也支持变量名 GEMINI_API_KEY=...

# 可选
CORS_ORIGINS=http://localhost:3000
